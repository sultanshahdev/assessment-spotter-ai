# Allowlist the build context, then exclude local/generated data at every depth.
**
!Dockerfile
!.dockerignore
!requirements-lock.txt
!manage.py
!gunicorn.conf.py
!backend/
!backend/**
!route_processing/
!route_processing/**
!routing_adapters/
!routing_adapters/**
!weather_risk/
!weather_risk/**
!weather_adapters/
!weather_adapters/**
!weather_analysis/
!weather_analysis/**
!trip_planning/
!trip_planning/**
!forecast_corridor/
!forecast_corridor/**
!location_search/
!location_search/**
!frontend/
!frontend/**
**/.git
**/.env
**/.env.*
!**/.env.example
**/.venv
**/venv
**/node_modules
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/dist
**/test-results
**/playwright-report
**/graphify-out
**/*.log
**/*.prof
**/*.trace
**/.DS_Store
**/.idea
**/.vscode
